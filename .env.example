APP_NAME=Drclick
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Drclick desktop runtime. The launcher replaces both local URLs with the
# same exact dynamic loopback origin. The LAN upload URL is a separate exact
# private/link-local/loopback IP origin with an explicit high port (for example
# http://192.168.1.40:43124). The optional remote URL is the exact public HTTPS
# origin (for example https://uploads.example.com).
MEDISMART_VERSION=0.1.0-dev
MEDISMART_SEED_DEMO_USER=false
MEDISMART_LOCAL_URL=http://127.0.0.1:8000
MEDISMART_LAN_UPLOAD_URL=
MEDISMART_REMOTE_UPLOAD_URL=
# Legacy unsupervised web fallback only; supervised QR URLs use the exact
# MEDISMART_LAN_UPLOAD_URL supplied for that listener instance.
MEDISMART_LAN_PORT=8000
MEDISMART_DESKTOP_SUPERVISED=false
# Native-supervisor observations. Browser development leaves the installation
# identity empty and the signed updater unavailable; users never edit these in
# an installed desktop application.
MEDISMART_DESKTOP_INSTALLATION_ID=
MEDISMART_SIGNED_UPDATER_CONFIGURED=false
# Website "Télécharger l’app desktop" button. Use either a public release URL
# or place the installer at storage/app/private/desktop/DrClickDz-Desktop-Setup.exe.
MEDISMART_DESKTOP_DOWNLOAD_URL=
MEDISMART_DESKTOP_INSTALLER_PATH=DrClickDz-Desktop-Setup.exe
MEDISMART_QUEUE_WORKER_STATUS=stopped
MEDISMART_SCHEDULER_STATUS=stopped
MEDISMART_LAN_LISTENER_STATUS=stopped
MEDISMART_HEALTH_DETAILS_KEY=
# Launcher-owned authenticated tunnel evidence. Installed desktop users do not
# set these manually; the launcher supplies the fixed private status path.
MEDISMART_NATIVE_TUNNEL_STATUS_PATH=
MEDISMART_NATIVE_TUNNEL_STATUS_MAXIMUM_AGE_MS=15000
MEDISMART_NATIVE_TUNNEL_STATUS_FUTURE_TOLERANCE_MS=2000
MEDISMART_ENABLE_LEGACY_SQLITE_RESTORE=false
MEDISMART_BACKUP_REMOTE_MAX_BYTES=26843545600
MEDISMART_BACKUP_RESTORE_UPLOAD_MAX_BYTES=26843545600
# Deployment-owned cleanup window for intact, never-applied preparations (24-8760 hours).
MEDISMART_PREPARED_RESTORE_RETENTION_HOURS=168
# Optional: canonical absolute local directory shared by archive creation,
# Drive downloads, restore-safety backups, and fail-closed retention.
# MEDISMART_BACKUP_MANAGED_DIRECTORY=/absolute/local/path/to/backups
MEDISMART_UPLOAD_EXPIRY_MINUTES=15
MEDISMART_UPLOAD_MAX_FILES=10
MEDISMART_UPLOAD_MAX_FILE_BYTES=20971520
MEDISMART_UPLOAD_MAX_TOTAL_BYTES=104857600

# Public verification material only. Never place a private signing key here.
# Use exact HTTPS endpoint URLs without credentials, query strings, redirects,
# or non-TLS ports; production should keep all three on one allowlisted origin.
MEDISMART_LICENSE_PRODUCT=medismart-desktop
MEDISMART_LICENSE_ACTIVATION_URL=
MEDISMART_LICENSE_STATUS_URL=
MEDISMART_LICENSE_DEACTIVATION_URL=
MEDISMART_LICENSE_PUBLIC_KEY_PATH=
MEDISMART_FINGERPRINT_PEPPER=
MEDISMART_LICENSE_CLOCK_TOLERANCE_HOURS=6

# Google Drive installed-app OAuth. Public desktop clients leave the secret
# empty. Confidential clients may still supply it. The launcher-derived
# MEDISMART_LOCAL_URL is the callback origin; an optional redirect value is
# accepted only when it exactly matches that current loopback callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/app/configuration/backup/google/callback
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file
# Deployment kill switch; retention counts and storage cap are saved in-app.
GOOGLE_DRIVE_RETENTION_ENABLED=true

# OnlyOffice Docs (run: docker compose -f compose.onlyoffice.yml up -d)
ONLYOFFICE_URL=http://localhost:8088
ONLYOFFICE_INTERNAL_URL=http://localhost:8088
ONLYOFFICE_APP_URL=http://host.docker.internal:8000
ONLYOFFICE_JWT_SECRET=

APP_TIMEZONE=Africa/Algiers

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# --- Clinic configuration (see config/clinic.php) ---
CLINIC_NAME="Drclick"
CLINIC_ADDRESS=
CLINIC_PHONE=
CLINIC_EMAIL=
CLINIC_TIMEZONE=Africa/Algiers

CLINIC_CURRENCY_CODE=DZD
CLINIC_CURRENCY_SYMBOL=DA
CLINIC_CURRENCY_LOCALE=fr_DZ
CLINIC_CURRENCY_MINOR_UNIT=2

CLINIC_APPOINTMENT_DURATION=30
CLINIC_APPOINTMENT_MIN_DURATION=5
CLINIC_APPOINTMENT_MAX_DURATION=240
CLINIC_LOW_STOCK_THRESHOLD=10
CLINIC_EXPIRY_WARNING_DAYS=30

CLINIC_REQUIRE_CASH_SESSION=true
CLINIC_PAYMENT_CASH=true
CLINIC_PAYMENT_CARD=true
CLINIC_PAYMENT_BANK_TRANSFER=false
CLINIC_PAYMENT_INSURANCE=false
CLINIC_PAYMENT_OTHER=false

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Opt in only for short, supervised diagnostics; Telescope may capture PHI.
TELESCOPE_ENABLED=false
INERTIA_DEVTOOLS_ENABLED=false

DB_CONNECTION=sqlite
# The desktop launcher supplies an absolute writable AppData path in production.
# DB_DATABASE=/absolute/writable/path/to/database.sqlite
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL
DB_TRANSACTION_MODE=DEFERRED
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_BLOCK=true
SESSION_BLOCK_STORE=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
