{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Drclick",
    "mainBinaryName": "Drclick",
    "version": "0.4.3",
    "identifier": "dz.click.medismart",
    "build": {
        "frontendDist": "frontend"
    },
    "app": {
        "windows": [],
        "security": {
            "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* https://drclickdz.com https://app.drclick.dz https://*.drclick.dz; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
            "capabilities": [
                "desktop-windows",
                "desktop-local-runtime",
                "desktop-lan-client",
                "connection-setup"
            ]
        },
        "withGlobalTauri": false
    },
    "bundle": {
        "active": true,
        "targets": [
            "nsis"
        ],
        "createUpdaterArtifacts": true,
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "resources": {
            "resources/php": "php",
            "resources/laravel": "laravel",
            "resources/initial": "initial"
        },
        "windows": {
            "webviewInstallMode": {
                "type": "embedBootstrapper",
                "silent": true
            },
            "wix": {
                "language": "fr-FR"
            },
            "nsis": {
                "languages": [
                    "French"
                ],
                "installerHooks": "windows/installer-hooks.nsh"
            }
        }
    }
}
