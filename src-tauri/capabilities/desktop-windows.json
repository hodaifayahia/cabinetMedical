{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "desktop-windows",
    "description": "The hosted Drclick application window may invoke signed-updater commands. No offline-restore, LAN, Google OAuth, opener, shell, or filesystem capability is granted.",
    "local": false,
    "remote": {
        "urls": [
            "http://localhost:8000/*",
            "https://seagreen-turkey-468004.hostingersite.com/*",
            "https://app.drclick.dz/*",
            "https://*.drclick.dz/*"
        ]
    },
    "windows": ["main"],
    "permissions": [
        "allow-signed-updater-status",
        "allow-check-for-signed-update",
        "allow-install-signed-update"
    ]
}
