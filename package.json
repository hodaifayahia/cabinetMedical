{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "desktop:build": "node scripts/desktop/build-thin-client.mjs",
        "desktop:check": "cargo check --manifest-path src-tauri/Cargo.toml --all-targets",
        "desktop:dev": "tauri dev",
        "desktop:dev:local": "node scripts/desktop/dev-local-thin-client.mjs",
        "desktop:core:test": "cargo test --manifest-path src-tauri/runtime-core/Cargo.toml",
        "desktop:queue:test": "cargo test --manifest-path src-tauri/runtime-core/Cargo.toml queue_worker",
        "desktop:release:readiness": "node scripts/desktop/check-release-readiness.mjs",
        "desktop:resources:review-php": "node scripts/desktop/create-php-runtime-review.mjs",
        "desktop:resources:fixture": "node scripts/desktop/release-resource-fixture.mjs",
        "desktop:resources:stage": "node scripts/desktop/stage-release-resources.mjs",
        "desktop:resources:test": "node --test scripts/desktop/release-resources.test.mjs",
        "desktop:resources:validate": "node scripts/desktop/validate-release-resources.mjs",
        "desktop:restore:test": "cargo test --manifest-path src-tauri/runtime-core/Cargo.toml offline_restore",
        "desktop:scheduler:test": "cargo test --manifest-path src-tauri/runtime-core/Cargo.toml scheduler",
        "desktop:tunnel:test": "cargo test --manifest-path src-tauri/runtime-core/Cargo.toml tunnel",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "test": "vitest run",
        "test:e2e": "npm run build && npm run test:e2e:prepare && playwright test",
        "test:e2e:install": "playwright install chromium",
        "test:e2e:prepare": "node tests/e2e/support/prepare-environment.mjs",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "types:check": "vue-tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@playwright/test": "^1.62.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/vite": "^4.1.11",
        "@tauri-apps/cli": "^2.11.4",
        "@types/node": "^22.13.5",
        "@types/qrcode": "^1.5.6",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/eslint-config-typescript": "^14.3.0",
        "@vue/test-utils": "^2.4.11",
        "concurrently": "^9.0.1",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-vue": "^9.32.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.23.0",
        "vite": "^8.0.0",
        "vitest": "^4.1.10",
        "vue-tsc": "^2.2.4"
    },
    "dependencies": {
        "@fullcalendar/core": "^6.1.21",
        "@fullcalendar/daygrid": "^6.1.21",
        "@fullcalendar/interaction": "^6.1.21",
        "@fullcalendar/list": "^6.1.21",
        "@fullcalendar/timegrid": "^6.1.21",
        "@fullcalendar/vue3": "^6.1.21",
        "@inertiajs/vite": "^3.0.0",
        "@inertiajs/vue3": "^3.0.0",
        "@internationalized/date": "^3.12.3",
        "@laravel/passkeys": "^0.2.0",
        "@lucide/vue": "^1.17.0",
        "@tauri-apps/api": "^2.11.1",
        "@vueuse/core": "^12.8.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-vite-plugin": "^3.0.0",
        "qrcode": "^1.5.4",
        "reka-ui": "^2.9.8",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "tw-animate-css": "^1.2.5",
        "vue": "^3.5.13",
        "vue-input-otp": "^0.3.2",
        "vue-sonner": "^2.0.0"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    }
}
